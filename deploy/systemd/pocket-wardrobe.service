[Unit]
Description=Pocket Wardrobe — your clothes and what to wear
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-wardrobe
Group=pocket-wardrobe
ExecStart=/usr/local/bin/pocket-wardrobe
Environment=DATA_DIR=/var/lib/pocket-wardrobe
Environment=PORT=8080
Environment=BASE_URL=https://wardrobe.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-wardrobe
PrivateTmp=true

[Install]
WantedBy=multi-user.target
