{
  "name": "Pocket Wardrobe",
  "short_name": "Wardrobe",
  "description": "Your clothes with photos: outfits for your style, the weather and your day, what you wore, laundry, packing and what is worth buying. Linked to your other Pocket apps.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#a83b6c",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/" },
    { "name": "Add a piece", "url": "/?add=item" },
    { "name": "Closet", "url": "/closet" }
  ]
}
